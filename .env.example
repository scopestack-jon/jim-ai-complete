# Environment Variables Template
# Copy this file to .env and replace with your actual values

# AWS Configuration
AWS_ACCESS_KEY_ID=AKIA_YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=your_40_character_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Flask Configuration  
SECRET_KEY=your_random_secret_key_for_flask_sessions

# Note: Never commit the actual .env file to version control
